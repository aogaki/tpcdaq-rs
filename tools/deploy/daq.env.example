# daq.env — daq_up.sh / daq_down.sh が読むホスト固有のパス(リポ外に置く。既定 /opt/tpcdaq/daq.env)。
# 値は NEW_DAQ_SETUP_ja.md の配置例。実機に合わせて書き換える。

TPCDAQ_REPO=/home/daq/tpcdaq-rs                 # cargo build --release 済みのチェックアウト
TPCDAQ_CONF=/opt/tpcdaq/daq.toml                 # SPEC §3 の設定(雛形 config/daq_example.toml)
TPCDAQ_LOGS=/srv/tpcdaq/logs                     # 各プロセスのログと pid
ROOT_SETUP=/opt/ROOT/bin/thisroot.sh
ROOT_SINK_EXPECT=0:0                             # mini = 0:0(ELITPC は 0:0,0:1,0:2,0:3)
ROOT_SINK_RECORDER_WORKERS=1                     # PEventTPC の並列書き出し本数。高レート(数十 Hz 以上)なら 4
                                                 # (ファイル名が run{N}_w{k}.root になる — TODO/109)
ROOT_SINK_DRAIN_S=600                            # daq_down.sh が root_sink の書き切りを待つ上限 [s](超えても kill しない)

# 実 ECC(NEW_DAQ_SETUP §5 A: 16.04 ビルド + xenial libs + VM 採取の Ice 3.7.2)
GET_BIN=/home/daq/ELITPC/GetSoftware_bin/20190315
ECC_CONFIG_DIR=/home/daq/ELITPC/GetSoftware_config
GET_LD_PATH=/home/daq/get_docker/vm_ice:$GET_BIN/lib:/home/daq/get_docker/stage/usr/lib/x86_64-linux-gnu:/home/daq/get_docker/stage/lib/x86_64-linux-gnu
